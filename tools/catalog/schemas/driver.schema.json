{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kokeb-labs/ci-tools/tools/catalog/schemas/driver.schema.json",
  "title": "driver.yml",
  "description": "A driver's metadata (handbook KB-REPO-018), as the compatibility catalogue reads it.",
  "type": "object",
  "required": ["name", "version", "bus", "mcus", "peripheral", "kb_core_min"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "version": {"$ref": "#/$defs/semver"},
    "bus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["spi", "i2c", "uart", "adc", "pio", "gpio", "can", "canopen", "modbus", "onewire"]}
    },
    "mcus": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "peripheral": {"type": ["string", "null"], "pattern": "^[a-z0-9_]+$"},
    "kb_core_min": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/semver"}]},
    "authors": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"}
  }
}
